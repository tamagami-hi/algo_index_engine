    "app_log": "/home/ubuntu/blackbox_trage/logs/app"
  },
  "images": [
    {
      "key": "engine",
      "archive": "engine.tar.gz"
    }
  ],
  "has_database": false,
  "health": {
    "mode": "container",
    "http_url": null,
    "settle_seconds": 20,
