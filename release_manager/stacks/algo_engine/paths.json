    "stack_dir": "/home/ubuntu/blackbox_trage/algo_engine",
    "paths_file": "/home/ubuntu/blackbox_trage/algo_engine/paths.json",
    "images_dir": "/home/ubuntu/blackbox_trage/algo_engine/images",
    "compose_file": "/home/ubuntu/blackbox_trage/algo_engine/compose.algo_engine.yml",
    "compose_name": "compose.algo_engine.yml",
    "env_file": "/home/ubuntu/blackbox_trage/algo_engine/.env",
    "env_example": "/home/ubuntu/blackbox_trage/algo_engine/.env.example",
    "version_file": "/home/ubuntu/blackbox_trage/algo_engine/engine-version.json",
    "version_name": "engine-version.json",
    "manifest_file": "/home/ubuntu/blackbox_trage/algo_engine/manifest.json",
    "checksums_file": "/home/ubuntu/blackbox_trage/algo_engine/checksums.sha256",
    "deploy_script": "/home/ubuntu/blackbox_trage/algo_engine/algo_engine_deploy.sh",
    "rollback_script": "/home/ubuntu/blackbox_trage/algo_engine/algo_engine_rollback.sh",
    "guide": "/home/ubuntu/blackbox_trage/algo_engine/ENGINE_GUIDE.md",
    "registry": "/home/ubuntu/blackbox_trage/manifest.json",
    "data_volume": "blackbox_engine_data",
    "docker": "docker",
    "container_prefix": "bb-engine",
    "compose_project": "blackbox_engine",
    "lock_file": "/run/lock/blackbox-algo_engine.lock"
  },
  "backup": {
    "root": "/home/ubuntu/blackbox_trage/backup",
