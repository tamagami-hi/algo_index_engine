# ─────────────────────────────────────────────────────────────────────────────
# Reference only. This file is NEVER copied over .env by any script.
#
# .env is placed and owned entirely by the operator. Nothing in the pipeline
# reads its contents, writes it, changes its mode, or removes it; the deploy
# checks only that it exists; Docker reads it for Compose interpolation and
# container configuration. Release manifests also record its checksum.
#
# Web login uses the backend HTTP server; no separate callback port is opened.
# Keep an SSH tunnel open from your browser's machine while logging in:
# ssh -N -L 8787:127.0.0.1:8787 beonedge
# ─────────────────────────────────────────────────────────────────────────────

# Required HTTP port for the backend, UI/API and callback, published on loopback.
# The deploy health probe follows this mapping. No image rebuild is needed.
# Compose uses this same port inside the container and on the host.
#
# 8787 is the port this repository uses, here and locally, and it is not a
# convention that can be changed on one side. The Dhan app registration pins
# DHAN_REDIRECT_URL to this exact port, so a different port here means browser
# login fails with a redirect mismatch. The nginx vhost proxies to it too, and
# every deploy checks the two agree.
BLACKBOX_HTTP_PORT=8787

DHAN_CLIENT_ID=
DHAN_API_KEY=

DHAN_AUTH_MODE=web
DHAN_API_SECRET=
# Register the expanded URL with Dhan, not the literal ${...} expression.
# Default: http://127.0.0.1:8787/dhan/callback (same host port as the UI/API).
DHAN_REDIRECT_URL=http://127.0.0.1:${BLACKBOX_HTTP_PORT}/dhan/callback

# Where Dhan posts live order status changes. Set it in the Postback URL field on
# web.dhan.co when generating the access token. The path must stay /dhan/postback,
# the only route that accepts them; startup refuses a URL that disagrees with what
# is served, because a 404 here loses real order events silently.
# Dhan does not deliver to localhost or 127.0.0.1, and this stack publishes only on
# loopback behind a tailnet-only vhost, so nothing public reaches the engine today.
# Dhan also signs nothing, so making it publicly reachable creates an
# unauthenticated write path. Leave empty until that is decided.
DHAN_POSTBACK_URL=

# Alternative token_url mode fetches a token without browser login.
DHAN_TOKEN_URL=
TOKEN_PASSCODE=

# Only for DHAN_AUTH_MODE=manual. A Dhan token lasts 24 hours, so this needs
# replacing daily and is not suitable for unattended operation.
DHAN_ACCESS_TOKEN=
