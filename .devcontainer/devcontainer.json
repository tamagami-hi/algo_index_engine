{
  "name": "Blackbox Trage",
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "/workspaces/blackbox_trage",
  "shutdownAction": "stopCompose",

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb"
      ]
    },
    "jetbrains": {
      "backend": "IntelliJ",
      "settings": {},
      "plugins": [
        "com.jetbrains.rust",
        "com.intellij.nativeDebug"
      ]
    }
  },

  "postCreateCommand": "cargo fetch",
  "remoteUser": "vscode"
}
