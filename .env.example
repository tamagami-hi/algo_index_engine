# Required HTTP port for the backend, Docker mapping, UI/API and Dhan callback.
# 8787 everywhere, locally and on the VPS. The Dhan app registration pins the
# callback URL to this port, so it is not a per-environment choice.
# No port is defaulted in the source or Compose. No image rebuild is needed.
BLACKBOX_HTTP_PORT=8787

# Native cargo/binary runs only. Compose overrides this inside the container.
BLACKBOX_HTTP_ADDR=127.0.0.1:${BLACKBOX_HTTP_PORT}

DHAN_CLIENT_ID=
DHAN_API_KEY=

# Choose web (browser login), token_url (HTTPS + passcode), or manual.
# Explicit mode wins over DHAN_ACCESS_TOKEN. oauth is an alias for web.
DHAN_AUTH_MODE=web
DHAN_API_SECRET=
# Must exactly match the redirect URL registered with your Dhan API key.
# Web mode receives the callback on the same port as the backend.
# Register the expanded URL with Dhan (default http://127.0.0.1:8787/dhan/callback).
# The listener receives tokenId and exchanges it for an access token.
# It is not started in token_url or manual mode.
DHAN_REDIRECT_URL=http://127.0.0.1:${BLACKBOX_HTTP_PORT}/dhan/callback

# Where Dhan posts live order status changes. Paste the expanded URL into the
# Postback URL field on web.dhan.co when generating the access token; the engine
# only receives, it never registers this for you.
# The path must stay /dhan/postback: it is the only route that accepts postbacks,
# so any other path answers 404 and the order events behind it are lost. Startup
# refuses a URL whose path or loopback port disagrees with what is served.
# Dhan will NOT deliver to localhost or 127.0.0.1, so the value below is only
# good for testing the endpoint yourself with curl. A live account needs a
# publicly routable URL, and Dhan signs nothing, so exposing one publicly means
# an unauthenticated write path. Leave this empty until that is settled.
DHAN_POSTBACK_URL=http://127.0.0.1:${BLACKBOX_HTTP_PORT}/dhan/postback

# Cal Spread token route. Only issues a token while its admin Dhan session is live,
# otherwise it replies 409 "No live Dhan session".
DHAN_TOKEN_URL=
TOKEN_PASSCODE=

# Optional override. Paste an access token generated directly from the Dhan
# dashboard with DHAN_AUTH_MODE=manual. If no mode is set, a nonempty token
# preserves the legacy behavior of taking precedence over DHAN_TOKEN_URL.
DHAN_ACCESS_TOKEN=
