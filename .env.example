DHAN_CLIENT_ID=
DHAN_API_KEY=

# Choose web (browser login), token_url (HTTPS + passcode), or manual.
# Explicit mode wins over DHAN_ACCESS_TOKEN. oauth is an alias for web.
DHAN_AUTH_MODE=token_url
DHAN_API_SECRET=
# Must exactly match the redirect URL registered with your Dhan API key.
# Web mode uses an automatic local callback; register this URL with Dhan.
DHAN_REDIRECT_URL=http://127.0.0.1:8787/dhan/callback

# Cal Spread token route. Only issues a token while its admin Dhan session is live,
# otherwise it replies 409 "No live Dhan session".
DHAN_TOKEN_URL=
TOKEN_PASSCODE=

# Optional override. Paste an access token generated directly from the Dhan
# dashboard with DHAN_AUTH_MODE=manual. If no mode is set, a nonempty token
# preserves the legacy behavior of taking precedence over DHAN_TOKEN_URL.
DHAN_ACCESS_TOKEN=
